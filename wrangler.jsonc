{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pin-directory",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2024-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  }
}
